# ==============================================================================
# Valheim Dedicated Server Environment Configuration (Oracle Cloud ARM64)
# ==============================================================================

# User / Group ID (Matches Ubuntu default user 'ubuntu' with UID 1000)
PUID=1000
PGID=1000

# Timezone (e.g., UTC, America/New_York, Europe/Madrid)
TZ=Europe/Madrid

# Server Information
SERVER_NAME="Valheim Oracle ARM64 Server"
WORLD_NAME="ValheimWorld"
# Minimum 5 characters, cannot be part of the server name. Do NOT commit real passwords!
SERVER_PASS="ChangeMeSecretPassword123"
SERVER_PUBLIC=1

# Crossplay support (enable if allowing players from Xbox/PlayStation/GamePass)
CROSSPLAY=false

# Box64 Tuning Parameters for Ampere A1 (ARM64)
# STRONGMEM: 2 provides strict memory consistency barriers needed by Unity on ARM64
BOX64_DYNAREC_STRONGMEM=2
BOX64_DYNAREC_BIGBLOCK=0
BOX64_DYNAREC_BLEEDING_EDGE=0
BOX64_LOG=1

# Backup Configuration
BACKUPS=true
BACKUPS_CRON="0 * * * *"
BACKUPS_MAX_AGE=7
BACKUPS_ZIP=true
BACKUPS_IF_IDLE=true

# Automatic Updates
UPDATE_CRON="*/30 * * * *"
UPDATE_IF_IDLE=true

# Scheduled Restart (e.g., 05:00 UTC if idle)
RESTART_CRON="0 5 * * *"
RESTART_IF_IDLE=true

# Optional Discord Webhook Notification
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
